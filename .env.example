# Template. Copy to .env and fill in the blanks -- .env is gitignored.
# Anything below the "credentials" line has no default in app/core/config.py:
# remove a key and the process refuses to start rather than guessing.

ENVIRONMENT=development
SQL_ECHO=false

# --- credentials and service addresses (required) ---

# Postgres from docker-compose.yml: user/password botly/botly, published on
# 5433 so it does not collide with a system Postgres on 5432.
DATABASE_URL=postgresql+asyncpg://botly:botly@localhost:5433/botly
TEST_DATABASE_URL=postgresql+asyncpg://botly:botly@localhost:5433/botly_test

# Redis from docker-compose.yml, published on 6380. db 0 holds the dedupe keys.
REDIS_URL=redis://localhost:6380/0

# Fernet key for channel_connections.credentials_encrypted. Losing it makes
# every stored bot token unrecoverable. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_ENCRYPTION_KEY=

# Separate Redis databases from the dedupe keys: flushing a stuck queue must not
# also erase the dedupe keyspace and replay every recent webhook.
CELERY_BROKER_URL=redis://localhost:6380/1
CELERY_RESULT_BACKEND=redis://localhost:6380/2

# --- behaviour knobs (optional -- config.py holds the intended defaults) ---
# DEDUPE_TTL_SECONDS=86400
# OUTBOUND_RATE_CAPACITY=20
# OUTBOUND_RATE_REFILL_PER_SECOND=1.0
# OUTBOUND_MAX_ATTEMPTS=3
